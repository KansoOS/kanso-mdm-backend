# --- App ---
NODE_ENV=development
APP_PORT=3000
# Origine(s) autorisées en CORS pour le dashboard (séparées par une virgule).
# :5173 = `npm run dev` direct, :8081 = dashboard-web via `docker compose up` (WEB_PORT).
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanso_mdm
POSTGRES_PORT=5432

# --- Prisma (host side: pointe vers localhost car port publié) ---
# En conteneur, docker-compose surcharge DATABASE_URL vers db:5432
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/kanso_mdm?schema=public"

# --- Auth ---
# Générer avec: openssl rand -base64 48 (32 caractères minimum)
JWT_SECRET=change_me
# Clé AES-256 (32 octets en base64) pour chiffrer les secrets TOTP. Générer avec: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=change_me
