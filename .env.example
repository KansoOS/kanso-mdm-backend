# --- App ---
NODE_ENV=development
APP_PORT=3000

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanso_mdm
POSTGRES_PORT=5432

# --- Prisma (host side: pointe vers localhost car port publié) ---
# En conteneur, docker-compose surcharge DATABASE_URL vers db:5432
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/kanso_mdm?schema=public"
