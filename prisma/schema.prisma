generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Helper {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AES-256-GCM encrypted base32 secret
  totpSecretEncrypted String?
  totpEnabled         Boolean   @default(false)
  // Last accepted 30s time step
  totpLastUsedStep    Int?
  mfaFailedAttempts   Int       @default(0)
  mfaLockedUntil      DateTime?

  recoveryCodes RecoveryCode[]
  sessions      Session[]
  spaceMemberships SpaceMembership[]
  mandates         Mandate[] @relation("MandateHolder")
  revokedMandates  Mandate[] @relation("MandateRevokedBy")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  helperId  String
  helper    Helper    @relation(fields: [helperId], references: [id], onDelete: Cascade)
  // Keyed HMAC of the code, never the code itself.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([helperId, codeHash])
}

model Session {
  id        String   @id @default(uuid())
  helperId  String
  helper    Helper   @relation(fields: [helperId], references: [id], onDelete: Cascade)
  // Keyed HMAC of the cookie value, never the raw token.
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastActivityAt DateTime @default(now())
}

model Space {
  id        String   @id @default(uuid())
  // No full name or diagnostic field by design: only a pseudonym, chosen
  // freely by whoever creates the space.
  pseudonym String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships SpaceMembership[]
  mandates    Mandate[]
}

// Join table: a space can have several helpers, a helper can be in several
// spaces (many-to-many).
model SpaceMembership {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  helperId  String
  helper    Helper   @relation(fields: [helperId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([spaceId, helperId])
}

// "Objet central du projet" (modelé sur Aidants Connect) : ce qu'un aidant
// précis a le droit de faire sur un espace précis, daté et révocable.
// La révocation des sessions / l'accès au journal décrits dans la spec
// ne sont pas couverts ici — hors du périmètre de ce ticket (GET + expiration).
model Mandate {
  id       String @id @default(uuid())
  spaceId  String
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  helperId String
  helper   Helper @relation("MandateHolder", fields: [helperId], references: [id], onDelete: Cascade)

  // Enumerated capability codes (e.g. "contacts.gerer"), never a boolean
  // "admin" flag. Not constrained to a closed Postgres enum yet: the full
  // catalog isn't finalized, so this stays a validated-format string list.
  scope     String[]
  startDate DateTime
  endDate   DateTime

  revokedAt   DateTime?
  revokedById String?
  revokedBy   Helper?   @relation("MandateRevokedBy", fields: [revokedById], references: [id])

  createdAt DateTime @default(now())
}
