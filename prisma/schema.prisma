generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Helper {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AES-256-GCM encrypted base32 secret
  totpSecretEncrypted String?
  totpEnabled         Boolean   @default(false)
  // Last accepted 30s time step
  totpLastUsedStep    Int?
  mfaFailedAttempts   Int       @default(0)
  mfaLockedUntil      DateTime?

  recoveryCodes RecoveryCode[]
  sessions      Session[]
  spaceMemberships SpaceMembership[]
}

model RecoveryCode {
  id        String    @id @default(uuid())
  helperId  String
  helper    Helper    @relation(fields: [helperId], references: [id], onDelete: Cascade)
  // Keyed HMAC of the code, never the code itself.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([helperId, codeHash])
}

model Session {
  id        String   @id @default(uuid())
  helperId  String
  helper    Helper   @relation(fields: [helperId], references: [id], onDelete: Cascade)
  // Keyed HMAC of the cookie value, never the raw token.
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastActivityAt DateTime @default(now())
}

model Space {
  id        String   @id @default(uuid())
  // No full name or diagnostic field by design: only a pseudonym, chosen
  // freely by whoever creates the space.
  pseudonym String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships SpaceMembership[]
  devices     Device[]
}

// Join table: a space can have several helpers, a helper can be in several
// spaces (many-to-many).
model SpaceMembership {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  helperId  String
  helper    Helper   @relation(fields: [helperId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([spaceId, helperId])
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Device {
  id        String       @id @default(uuid())
  spaceId   String
  space     Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  pseudonym String
  status    DeviceStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pairingCodes DevicePairingCode[]

  @@unique([spaceId, pseudonym])
}

model DevicePairingCode {
  id        String    @id @default(uuid())
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
