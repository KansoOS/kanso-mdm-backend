# syntax=docker/dockerfile:1.7
# Image de dev : dépendances (incl. devDependencies) installées au build,
# code monté en volume au run (hot-reload via `nest start --watch`).
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund && npx prisma generate
EXPOSE 3000
CMD ["npm", "run", "start:dev"]
